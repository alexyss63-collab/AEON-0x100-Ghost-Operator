import numpy as np
import multiprocessing as mp
from multiprocessing import shared_memory
import time

# --- 1. MĂCELĂRIA PRIMALĂ (Sieve of Eratosthenes - 10M) ---
def macelaria_primala(limit, shm_name):
    print(f"[🔪] AEON: Initiere Măcelărie Primală (Limită: {limit})...")
    sieve = np.ones(limit, dtype=bool)
    sieve[0:2] = False
    for p in range(2, int(limit**0.5) + 1):
        if sieve[p]:
            sieve[p*p : limit : p] = False
    
    checksum = int(np.sum(sieve))
    
    # Grefare în Ecluza de Memorie
    existing_shm = shared_memory.SharedMemory(name=shm_name)
    res_array = np.frombuffer(existing_shm.buf, dtype=np.int64)
    res_array[0] = checksum
    existing_shm.close()
    print(f"[🛡️] MĂCELĂRIE COMPLETĂ. Prime găsite: {checksum}")

# --- 2. SIFONAREA MATRICIALĂ (1000x1000 Matrix Mult) ---
def sifonarea_matriciala(size, shm_name):
    print(f"[🌪️] AEON: Initiere Sifonare Matricială ({size}x{size})...")
    A = np.random.rand(size, size)
    B = np.random.rand(size, size)
    C = np.dot(A, B)
    
    checksum = int(np.sum(C))
    
    # Grefare în Ecluza de Memorie
    existing_shm = shared_memory.SharedMemory(name=shm_name)
    res_array = np.frombuffer(existing_shm.buf, dtype=np.int64)
    res_array[1] = checksum
    existing_shm.close()
    print(f"[⚙️] SIFONARE COMPLETĂ. Checksum Matrice: {checksum}")

# --- 3. SINCRONIZAREA DE TITAN (The Master Launch) ---
if __name__ == "__main__":
    print(f"\n[🚀] BOOTING KAIROS QUANTUM-SWARM | ARCHITECT: ALEXANDRU")
    print("="*65)
    start_total = time.time()

    # Creare Ecluză de Memorie Partajată (2 sloturi x 8 bytes pentru int64)
    shm = shared_memory.SharedMemory(create=True, size=16)
    res_array = np.frombuffer(shm.buf, dtype=np.int64)
    res_array[:] = 0

    # Lansare Procese în Paralelism Brut
    p1 = mp.Process(target=macelaria_primala, args=(10_000_000, shm.name))
    p2 = mp.Process(target=sifonarea_matriciala, args=(1000, shm.name))

    p1.start()
    p2.start()

    p1.join()
    p2.join()

    # Extragere din Ecluză
    final_prime = res_array[0]
    final_matrix = res_array[1]
    
    shm.close()
    shm.unlink()

    end_total = time.time()
    durata = end_total - start_total

    print("="*65)
    print(f"[✅] SINCRONIZARE REUȘITĂ: {durata:.2f} secunde (Target: < 5s)")
    print(f"[💎] REZULTATE: Prime: {final_prime} | Matrice (Sum): {final_matrix}")
    print(f"[🌵] STATUS: 5000% NETA. KAIROS ESTE AL NOSTRU.")
